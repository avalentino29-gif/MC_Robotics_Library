//COMMENTS FOR CODE ___________________________________________
/*

MAV is similar to motor and power, but is more relaible.
    
    MAV just stands for Move At Velocity.
    
    Function for code is in order.     
        
    Button sensor on the back = 0
    
    Right Front wheel = 2
    
    Right Back wheel = 3
    
    Left Front wheel = 1
    
    Left Back wheel = 0!
    
    Pickup = 2
    
    Arm = 1
    
    Claw = 3
________________________________________________________ */

void drive (int velocity) {
    mav(0, velocity);
    mav(1, velocity);
    mav(2, velocity);
    mav(3, velocity);

}	
void turnr(int power){
    mav (0, power);
    mav (1, power);     
    mav (2, -power);
    mav (3, -power); 
}

void turnl(int power){
    mav (0, -power);
    mav (1, -power);     
    mav (2, power);
    mav (3, power);
}

void right(int power){
	mav (0, -power);
    mav (1, power);     
    mav (2, -power);
    mav (3, power);

}    
void left(int power){

    mav (0, power);
    mav (1, -power);     
    mav (2, power);
    mav (3, -power);

}

void arm(int degree){

    enable_servos();
   
    set_servo_position(1, degree); 
    
    msleep(100);

    ao();

}

void claw(int degree, int time){
     enable_servos();
   
    set_servo_position(3, degree); 

    msleep(time);

    ao();

 
}

void pickup(int degree){
    enable_servos();
    
    set_servo_position(2, degree); 
    
    msleep(100);
        
    ao();
}

void get_out_of_starting_box(){   
    
   mav (0, 1000); //turn 
   mav (1, 1000);     
   mav (2, -1000);
   mav (3, -1000);
   msleep(2000); 

   while (digital (0) == 0){ //Button sensor
        
       mav (0, -1000);
       mav (1, -1000);     
       mav (2, -1000);
       mav (3, -1000);    

        if (digital (0) == 1){
            break;
        }
    }

    mav (0, 1000); //move left to the wall 
    mav (1, -1000);     
    mav (2, 1000);
    mav (3, -1000);
    msleep (1000); 

}
